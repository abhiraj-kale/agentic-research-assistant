{
  "manifest_version": 3,
  "name": "AI Research Assistant",
  "description": "An agentic AI assistant that performs deep research and generates reports via Side Panel.",
  "version": "2.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://agentic-research-assistant-yoh8.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Click to open Research Assistant"
  }
}